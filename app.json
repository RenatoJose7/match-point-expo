{
  "expo": {
    "name": "Match Point",
    "slug": "match-point",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "scheme": [
      "matchpoint",
      "com.renatojose.matchpoint"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/monogram.png"
    },
    "android": {
      "package": "com.renatojose.matchpoint",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#0b542d"
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "56ca1dd5-e345-44ac-96de-b96188208f9e"
      }
    },
    "owner": "renatojose7"
  }
}
