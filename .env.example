# Use firebase para persistir dados reais. O arquivo .env nunca deve ser enviado ao Git.
EXPO_PUBLIC_DATA_PROVIDER=firebase

# Configuração pública do aplicativo Firebase.
# Nunca coloque contas de serviço, chaves privadas ou senhas neste arquivo.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# IDs OAuth públicos criados no Google Cloud/Firebase Authentication.
# Configure os três para builds nativos e o navegador; nenhum client secret vai aqui.
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
