rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function application(applicationId) {
      return firestore.get(
        /databases/(default)/documents/candidaturas/$(applicationId)
      ).data;
    }

    function ownsAthlete(athleteId) {
      return signedIn()
        && firestore.get(
          /databases/(default)/documents/atletas/$(athleteId)
        ).data.usuarioId == request.auth.uid;
    }

    function ownsPartner(partnerId) {
      return signedIn()
        && firestore.get(
          /databases/(default)/documents/parceiros/$(partnerId)
        ).data.usuarioId == request.auth.uid;
    }

    function ownsOpportunity(opportunityId) {
      return ownsPartner(
        firestore.get(
          /databases/(default)/documents/oportunidades/$(opportunityId)
        ).data.criadorId
      );
    }

    function athleteOwnsApplication(applicationId) {
      return ownsAthlete(application(applicationId).atletaId);
    }

    function partnerOwnsApplication(applicationId) {
      return ownsOpportunity(application(applicationId).oportunidadeId);
    }

    function validDocumentUpload() {
      return request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches(
          '(application/pdf|application/octet-stream|image/.*|video/mp4|video/webm)'
        );
    }

    function validProfilePhoto() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /perfis/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validProfilePhoto();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /candidaturas/{applicationId}/{fileName=**} {
      allow read: if signedIn()
        && (
          athleteOwnsApplication(applicationId)
          || partnerOwnsApplication(applicationId)
        );
      allow create, update: if signedIn()
        && athleteOwnsApplication(applicationId)
        && validDocumentUpload();
      allow delete: if signedIn() && athleteOwnsApplication(applicationId);
    }

    match /{fileName=**} {
      allow read, write: if false;
    }
  }
}
