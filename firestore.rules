rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userType() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo;
    }

    function isPartnerUser() {
      return signedIn() && userType() in ['treinador', 'instituicao'];
    }

    function ownsAthlete(athleteId) {
      return signedIn()
        && get(/databases/$(database)/documents/atletas/$(athleteId)).data.usuarioId == request.auth.uid;
    }

    function ownsGuardian(guardianId) {
      return signedIn()
        && get(/databases/$(database)/documents/responsaveis/$(guardianId)).data.usuarioId == request.auth.uid;
    }

    function ownsPartner(partnerId) {
      return signedIn()
        && get(/databases/$(database)/documents/parceiros/$(partnerId)).data.usuarioId == request.auth.uid;
    }

    function verifiedPartner(partnerId) {
      return ownsPartner(partnerId)
        && get(/databases/$(database)/documents/parceiros/$(partnerId)).data.verificado == true;
    }

    function ownsOpportunity(opportunityId) {
      return signedIn()
        && ownsPartner(
          get(/databases/$(database)/documents/oportunidades/$(opportunityId)).data.criadorId
        );
    }

    function ownsApplicationAthlete(application) {
      return ownsAthlete(application.atletaId);
    }

    function ownsApplicationOpportunity(application) {
      return ownsOpportunity(application.oportunidadeId);
    }

    function canNotifyApplicationAthlete(applicationId, userId) {
      let application = get(/databases/$(database)/documents/candidaturas/$(applicationId)).data;
      let athlete = get(/databases/$(database)/documents/atletas/$(application.atletaId)).data;
      return ownsApplicationOpportunity(application) && athlete.usuarioId == userId;
    }

    function candidateApplicationExists(opportunityId, athleteId, applicationId) {
      let applicationPath = /databases/$(database)/documents/candidaturas/$(applicationId);
      return exists(applicationPath)
        && get(applicationPath).data.id == applicationId
        && get(applicationPath).data.oportunidadeId == opportunityId
        && get(applicationPath).data.atletaId == athleteId;
    }

    function candidateApplicationExistsAfter(opportunityId, athleteId, applicationId) {
      let applicationPath = /databases/$(database)/documents/candidaturas/$(applicationId);
      return existsAfter(applicationPath)
        && getAfter(applicationPath).data.id == applicationId
        && getAfter(applicationPath).data.oportunidadeId == opportunityId
        && getAfter(applicationPath).data.atletaId == athleteId;
    }

    function validPublicCandidateProfile(athleteId, profile) {
      let athlete = get(/databases/$(database)/documents/atletas/$(athleteId)).data;
      let user = get(/databases/$(database)/documents/usuarios/$(athlete.usuarioId)).data;
      return profile is map
        && profile.keys().hasOnly([
          'nome',
          'fotoUrl',
          'modalidade',
          'categoria',
          'posicao',
          'maoDominante',
          'equipeAtual',
          'tempoDePratica',
          'ranking',
          'torneiosDisputados',
          'titulos',
          'perfilCompleto'
        ])
        && profile.keys().hasAll([
          'nome',
          'fotoUrl',
          'modalidade',
          'categoria',
          'posicao',
          'maoDominante',
          'equipeAtual',
          'tempoDePratica',
          'ranking',
          'torneiosDisputados',
          'titulos',
          'perfilCompleto'
        ])
        && user.tipo == 'atleta'
        && profile.nome == user.get('nome', '')
        && profile.fotoUrl == user.get('fotoUrl', null)
        && profile.modalidade == athlete.get('modalidade', '')
        && profile.categoria == athlete.get('categoria', null)
        && profile.posicao == athlete.get('posicao', null)
        && profile.maoDominante == athlete.get('maoDominante', null)
        && profile.equipeAtual == athlete.get('equipeAtual', null)
        && profile.tempoDePratica == athlete.get('tempoDePratica', null)
        && profile.ranking == athlete.get('ranking', null)
        && profile.torneiosDisputados == athlete.get('torneiosDisputados', null)
        && profile.titulos == athlete.get('titulos', null)
        && profile.perfilCompleto == athlete.get('perfilCompleto', false);
    }

    function guardianCanAccessAthlete(athlete) {
      return athlete.responsavelId != null && ownsGuardian(athlete.responsavelId);
    }

    function validGuardianLinkAfter(guardianId) {
      let athlete = getAfter(
        /databases/$(database)/documents/atletas/$(request.auth.uid)
      ).data;
      let invitation = getAfter(
        /databases/$(database)/documents/convitesResponsavel/$(athlete.vinculoResponsavelId)
      ).data;
      return athlete.usuarioId == request.auth.uid
        && athlete.responsavelId == guardianId
        && invitation.responsavelId == guardianId
        && invitation.status == 'utilizado'
        && invitation.utilizadoPorAtletaId == request.auth.uid;
    }

    function validApplicationStatus(status) {
      return status in [
        'iniciada',
        'inscrita',
        'documentos_enviados',
        'em_analise',
        'aprovada',
        'rejeitada'
      ];
    }

    function validApplicationTransition(previousStatus, nextStatus) {
      return (previousStatus == 'inscrita' && nextStatus in ['documentos_enviados', 'em_analise'])
        || (previousStatus == 'documentos_enviados' && nextStatus == 'em_analise')
        || (previousStatus == 'em_analise' && nextStatus in ['aprovada', 'rejeitada']);
    }

    function hasValidStatusHistoryAppend() {
      let previousHistory = resource.data.historico;
      let nextHistory = request.resource.data.historico;
      let nextEvent = nextHistory[previousHistory.size()];
      return nextHistory is list
        && nextHistory.size() == previousHistory.size() + 1
        && nextEvent is map
        && nextEvent.keys().hasOnly([
          'id',
          'status',
          'statusAnterior',
          'statusNovo',
          'descricao',
          'data',
          'responsavelId'
        ])
        && nextEvent.keys().hasAll([
          'id',
          'status',
          'statusAnterior',
          'statusNovo',
          'descricao',
          'data',
          'responsavelId'
        ])
        && nextEvent.status == request.resource.data.status
        && nextEvent.statusAnterior == resource.data.status
        && nextEvent.statusNovo == request.resource.data.status
        && nextEvent.responsavelId == request.auth.uid;
    }

    match /usuarios/{userId} {
      allow create: if isOwnUser(userId)
        && request.resource.data.id == userId
        && request.resource.data.tipo in [
          'atleta',
          'treinador',
          'instituicao',
          'responsavel',
          'administrador'
        ];
      allow read: if isOwnUser(userId);
      allow update: if isOwnUser(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.tipo == resource.data.tipo;
      allow delete: if false;
    }

    match /atletas/{athleteId} {
      allow create: if signedIn()
        && request.resource.data.id == athleteId
        && request.resource.data.usuarioId == request.auth.uid
        && (
          !('responsavelId' in request.resource.data)
          || validGuardianLinkAfter(request.resource.data.responsavelId)
        );
      allow read: if signedIn()
        && (
          resource.data.usuarioId == request.auth.uid
          || guardianCanAccessAthlete(resource.data)
        );
      allow update: if signedIn()
        && (
          resource.data.usuarioId == request.auth.uid
          || guardianCanAccessAthlete(resource.data)
        )
        && request.resource.data.id == resource.data.id
        && request.resource.data.usuarioId == resource.data.usuarioId
        && request.resource.data.get('responsavelId', null)
          == resource.data.get('responsavelId', null)
        && request.resource.data.get('vinculoResponsavelId', null)
          == resource.data.get('vinculoResponsavelId', null);
      allow delete: if false;
    }

    match /parceiros/{partnerId} {
      allow create: if signedIn()
        && request.resource.data.id == partnerId
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.tipo in ['treinador', 'instituicao'];
      allow read: if signedIn();
      allow update: if signedIn()
        && resource.data.usuarioId == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.usuarioId == resource.data.usuarioId
        && request.resource.data.tipo == resource.data.tipo;
      allow delete: if false;
    }

    match /responsaveis/{guardianId} {
      allow create: if signedIn()
        && request.resource.data.id == guardianId
        && request.resource.data.usuarioId == request.auth.uid;
      allow read: if signedIn() && resource.data.usuarioId == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.id == resource.data.id
        && request.resource.data.usuarioId == resource.data.usuarioId
        && (
          (
            resource.data.usuarioId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['parentesco', 'documento', 'telefone', 'atualizadoEm'])
          )
          || (
            validGuardianLinkAfter(guardianId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['atletasVinculadosIds', 'atualizadoEm'])
            && request.resource.data.atletasVinculadosIds.size()
              == resource.data.atletasVinculadosIds.size() + 1
            && request.resource.data.atletasVinculadosIds
              .hasAll(resource.data.atletasVinculadosIds)
            && !resource.data.atletasVinculadosIds
              .hasAny([request.auth.uid])
            && request.resource.data.atletasVinculadosIds
              .hasAny([request.auth.uid])
          )
        );
      allow delete: if false;
    }

    match /convitesResponsavel/{linkCode} {
      allow create: if signedIn()
        && request.resource.data.id == linkCode
        && request.resource.data.codigo == linkCode
        && request.resource.data.status == 'ativo'
        && request.resource.data.expiraEmEpoch is number
        && request.resource.data.expiraEmEpoch > request.time.toMillis()
        && ownsGuardian(request.resource.data.responsavelId);
      allow get: if signedIn()
        && (
          ownsGuardian(resource.data.responsavelId)
          || resource.data.status == 'ativo'
        );
      allow list: if false;
      allow update: if signedIn()
        && resource.data.status == 'ativo'
        && resource.data.expiraEmEpoch > request.time.toMillis()
        && request.resource.data.id == resource.data.id
        && request.resource.data.codigo == resource.data.codigo
        && request.resource.data.responsavelId == resource.data.responsavelId
        && request.resource.data.status == 'utilizado'
        && request.resource.data.utilizadoPorAtletaId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'utilizadoPorAtletaId', 'utilizadoEm'])
        && validGuardianLinkAfter(resource.data.responsavelId);
      allow delete: if false;
    }

    match /oportunidades/{opportunityId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.id == opportunityId
        && ownsPartner(request.resource.data.criadorId)
        && (
          request.resource.data.status != 'ativa'
          || verifiedPartner(request.resource.data.criadorId)
        );
      allow update: if signedIn()
        && ownsPartner(resource.data.criadorId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.criadorId == resource.data.criadorId
        && (
          request.resource.data.status != 'ativa'
          || verifiedPartner(resource.data.criadorId)
        );
      allow delete: if false;
    }

    match /oportunidades/{opportunityId}/perfisCandidatos/{athleteId} {
      allow get, list: if isPartnerUser()
        && ownsOpportunity(opportunityId)
        && resource.data.oportunidadeId == opportunityId
        && resource.data.atletaId == athleteId
        && candidateApplicationExists(
          opportunityId,
          athleteId,
          resource.data.candidaturaId
        );
      allow create: if signedIn()
        && ownsAthlete(athleteId)
        && request.resource.data.keys().hasOnly([
          'oportunidadeId',
          'atletaId',
          'candidaturaId',
          'perfilPublico'
        ])
        && request.resource.data.keys().hasAll([
          'oportunidadeId',
          'atletaId',
          'candidaturaId',
          'perfilPublico'
        ])
        && request.resource.data.oportunidadeId == opportunityId
        && request.resource.data.atletaId == athleteId
        && request.resource.data.candidaturaId is string
        && candidateApplicationExistsAfter(
          opportunityId,
          athleteId,
          request.resource.data.candidaturaId
        )
        && validPublicCandidateProfile(athleteId, request.resource.data.perfilPublico);
      allow update, delete: if false;
    }

    match /candidaturas/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.id == applicationId
        && ownsApplicationAthlete(request.resource.data)
        && request.resource.data.status == 'inscrita'
        && validApplicationStatus(request.resource.data.status);
      allow read: if signedIn()
        && (
          ownsApplicationAthlete(resource.data)
          || ownsApplicationOpportunity(resource.data)
          || guardianCanAccessAthlete(
            get(/databases/$(database)/documents/atletas/$(resource.data.atletaId)).data
          )
        );
      allow update: if signedIn()
        && request.resource.data.id == resource.data.id
        && request.resource.data.atletaId == resource.data.atletaId
        && request.resource.data.oportunidadeId == resource.data.oportunidadeId
        && validApplicationStatus(request.resource.data.status)
        && (
          (
            ownsApplicationAthlete(resource.data)
            && (
              (
                request.resource.data.status == resource.data.status
                && request.resource.data.historico == resource.data.historico
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['documentos', 'atualizadoEm'])
              )
              || (
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['documentos', 'status', 'historico', 'atualizadoEm'])
                && validApplicationTransition(
                  resource.data.status,
                  request.resource.data.status
                )
                && hasValidStatusHistoryAppend()
              )
            )
          )
          || (
            ownsApplicationOpportunity(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'historico', 'atualizadoEm'])
            && validApplicationTransition(
              resource.data.status,
              request.resource.data.status
            )
            && hasValidStatusHistoryAppend()
          )
        );
      allow delete: if false;
    }

    match /chavesCandidatura/{applicationKey} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && ownsAthlete(request.resource.data.atletaId)
        && request.resource.data.candidaturaId is string
        && request.resource.data.oportunidadeId is string;
      allow update, delete: if false;
    }

    match /notificacoes/{notificationId} {
      allow get, list: if signedIn() && resource.data.usuarioId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.id == notificationId
        && request.resource.data.usuarioId is string
        && request.resource.data.candidaturaId is string
        && request.resource.data.oportunidadeId is string
        && request.resource.data.titulo is string
        && request.resource.data.mensagem is string
        && request.resource.data.lida == false
        && canNotifyApplicationAthlete(request.resource.data.candidaturaId, request.resource.data.usuarioId);
      allow update: if signedIn()
        && resource.data.usuarioId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida', 'lidaEm'])
        && request.resource.data.lida == true;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
